# Normaliza finais de linha e marca binarios (evita avisos LF/CRLF e diffs ruidosos).
* text=auto

# Texto da Unity: sempre LF no repositorio.
*.cs text eol=lf
*.asmdef text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.inputactions text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binarios
*.png binary
*.jpg binary
*.mp3 binary
*.wav binary
*.ogg binary
*.ttf binary
*.zip binary
